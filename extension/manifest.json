{
  "manifest_version": 3,
  "name": "DSH ChatGPT Web Bridge",
  "description": "Local browser bridge for the dsh-chatgpt-web DeepSeek Harness plugin.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://chatgpt.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt-page-adapter.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
